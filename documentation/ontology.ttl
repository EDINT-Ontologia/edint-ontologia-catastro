@prefix : <https://edint.es/def/catastro#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://edint.es/def/catastro#> .

<https://edint.es/def/catastro#> rdf:type owl:Ontology ;
                                  owl:versionIRI <https://edint.es/def/catastro/0.2.1> ;
                                  owl:imports <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero> ,
                                              <http://www.opengis.net/ont/geosparql> ;
                                  <http://purl.org/dc/terms/abstract> "Ontología para modelar las entidades del Catastro Español, centrada en Parcelas, Inmuebles y Construcciones. Reutiliza GeoSPARQL, conceptos INSPIRE y el vocabulario de callejero español."@en ,
                                                                      "Ontología para modelar las entidades del Catastro Español, centrada en Parcelas, Inmuebles y Construcciones. Reutiliza GeoSPARQL, conceptos INSPIRE y el vocabulario de callejero español."@es ;
                                  <http://purl.org/dc/terms/bibliographicCitation> "EDINT Spanish Cadastre Ontology. EDINT. Revision: v0.2.1."@en ,
                                                                                   "Ontología EDINT del Catastro Español. EDINT. Revisión: v0.2.1."@es ;
                                  <http://purl.org/dc/terms/created> "2026-04-09"^^xsd:date ;
                                  <http://purl.org/dc/terms/creator> _:genid1 ,
                                                                     _:genid2 ,
                                                                     _:genid3 ,
                                                                     _:genid4 ,
                                                                     _:genid5 ;
                                  <http://purl.org/dc/terms/description> "Ontology for modeling Spanish Cadastre entities, focused on Parcels, Properties and Buildings. Reuses GeoSPARQL, INSPIRE concepts, and the Spanish street catalog (callejero) vocabulary."@en ,
                                                                         "Ontología para modelar las entidades del Catastro Español, centrada en Parcelas, Inmuebles y Construcciones. Reutiliza GeoSPARQL, conceptos INSPIRE y el vocabulario de callejero español."@es ;
                                  <http://purl.org/dc/terms/hasFormat> :ontology.owl ;
                                  <http://purl.org/dc/terms/issued> "2026-09-17"^^xsd:date ;
                                  <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                  <http://purl.org/dc/terms/modified> "2026-09-17"^^xsd:date ;
                                  <http://purl.org/dc/terms/publisher> _:genid6 ;
                                  <http://purl.org/dc/terms/title> "EDINT Spanish Cadastre Ontology"@en ,
                                                                   "Ontología EDINT del Catastro Español"@es ;
                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintcat" ;
                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "https://edint.es/def/catastro#" ;
                                  <http://schema.org/codeRepository> <https://github.com/EDINT-Ontologia/edint-ontologia-catastro> ;
                                  <http://schema.org/creativeWorkStatus> "Ontology Specification"@en ;
                                  <http://schema.org/funding> "Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)" ;
                                  rdfs:comment "Initial draft version focusing on core classes: CadastralParcel, CadastralProperty, and CadastralConstruction with their relationships and properties."@en ,
                                               "Versión inicial centrada en las clases principales: ParcelaCatastral, Inmueble y Construcción con sus relaciones y propiedades."@es ;
                                  rdfs:label "Catastro Español"@es ,
                                             "Spanish Cadastre"@en ;
                                  owl:priorVersion <https://github.com/EDINT-Ontologia/edint-ontologia-catastro/releases/tag/v0.2.0> ;
                                  owl:versionInfo "0.2.1" ;
                                  <https://w3id.org/widoco/vocab#jsonldSerialization> "ontology.jsonld" ;
                                  <https://w3id.org/widoco/vocab#ntSerialization> "ontology.nt" ;
                                  <https://w3id.org/widoco/vocab#rdfxmlSerialization> "ontology.rdf" ;
                                  <https://w3id.org/widoco/vocab#turtleSerialization> "ontology.ttl" ;
                                  <https://w3id.org/widoco/vocab#vocabularyLabel> _:genid7 ,
                                                                                  _:genid8 ,
                                                                                  _:genid9 .

_:genid1 <http://schema.org/affiliation> <https://oeg.fi.upm.es/> ;
          <http://xmlns.com/foaf/0.1/name> "Maria del Socorro Bernardos" .

_:genid2 <http://schema.org/affiliation> <https://oeg.fi.upm.es/> ;
          <http://xmlns.com/foaf/0.1/name> "Oscar Corcho" .

_:genid3 <http://schema.org/affiliation> <https://oeg.fi.upm.es/> ;
          <http://xmlns.com/foaf/0.1/name> "Daniel Doña" .

_:genid4 <http://schema.org/affiliation> <https://oeg.fi.upm.es/> ;
          <http://xmlns.com/foaf/0.1/name> "Edna Ruckhaus" .

_:genid5 <http://schema.org/affiliation> <https://oeg.fi.upm.es/> ;
          <http://xmlns.com/foaf/0.1/name> "Lucía Sánchez" .

_:genid6 <http://schema.org/affiliation> "Federación Española de Municipios y Provincias" ;
          <http://xmlns.com/foaf/0.1/homepage> <https://www.femp.es/> ;
          <http://xmlns.com/foaf/0.1/name> "FEMP" .

_:genid7 rdfs:label "GeoSPARQL"@en ,
                     "GeoSPARQL"@es ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <http://www.opengis.net/ont/geosparql> .

_:genid8 rdfs:label "Dirección Postal (esdir)"@es ,
                     "Postal Address (esdir)"@en ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> .

_:genid9 rdfs:label "Callejero (escjr)"@es ,
                     "Street catalogue (escjr)"@en ;
          <https://w3id.org/widoco/vocab#vocabularyIRI> <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero> .

